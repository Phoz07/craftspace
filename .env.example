# ==============================================================================
# CRAFTSPACE PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (Neon Serverless PostgreSQL - Free Tier)
# ------------------------------------------------------------------------------
# Connection string with connection pooling (PgBouncer) for Vercel Serverless Lambdas:
DATABASE_URL="postgresql://[user]:[password]@[neon-hostname]-pooler.[region].aws.neon.tech/neondb?sslmode=require"

# Direct connection string for Prisma schema push/migrations (without pooler):
DIRECT_URL="postgresql://[user]:[password]@[neon-hostname].[region].aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. STUDIO SALES ADMIN AUTHENTICATION
# ------------------------------------------------------------------------------
# Passcode used by studio designers and sales agents to access /admin:
ADMIN_PASSCODE="CraftSpace#2026!Studio"

# Cryptographic secret for signing HMAC SHA-256 session cookies:
ADMIN_SECRET="replace-with-a-random-32-character-secret-string"

# ------------------------------------------------------------------------------
# 3. LINE OFFICIAL ACCOUNT (LINE OA)
# ------------------------------------------------------------------------------
# Official Studio LINE OA Basic ID or Premium ID (including @):
NEXT_PUBLIC_LINE_OA_ID="@craftspace"

# ------------------------------------------------------------------------------
# 4. PUBLIC BASE URL
# ------------------------------------------------------------------------------
# Production domain for generating absolute URLs:
NEXT_PUBLIC_BASE_URL="https://your-domain.vercel.app"
